# History files
.Rhistory
.Rapp.history
renv/library

# Session Data files
data/.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site — NOT ignored here. The stock R template ignores docs/ because
# pkgdown generates a site there, but this project has no pkgdown site and docs/
# holds hand-written documentation (METHODS.md, DECISIONS.md) that must be
# tracked. Re-adding a blanket docs/ rule would silently un-commit it.
# docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# ---- Data: never commit DHS microdata -------------------------------------
# The DHS data licence forbids redistributing these files. They live outside
# this repo in ../../02-data/ — see phd/README.md.
data/
*.DTA
*.dta
*.SAV
*.sav
*.rds
*.RData

# ---- Credentials ----------------------------------------------------------
token.txt
*.pat
.Renviron
